# Скопируй в .env на сервере и заполни значения:
#   cp .env.example .env

POSTGRES_DB=sportdok
POSTGRES_USER=sportdok_user
POSTGRES_PASSWORD=смени_на_длинный_пароль

# Случайная длинная строка для JWT (не оставляй пример)
SECRET_KEY=смени_на_случайную_строку_минимум_32_символа

# Публичный адрес сайта (после HTTPS — https://)
FRONTEND_URL=https://sportdoc24.ru
CORS_ORIGINS=https://sportdoc24.ru,http://sportdoc24.ru,http://217.149.19.36

# Пусто = браузер ходит на /api того же хоста через nginx
VITE_API_URL=

# Почта (обязательно для писем клубам). Пример для Timeweb:
# создайте ящик вроде noreply@sportdoc24.ru в панели Timeweb
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=noreply@sportdoc24.ru
SMTP_PASSWORD=пароль_от_почтового_ящика
SMTP_FROM=СпортДок <noreply@sportdoc24.ru>
SMTP_USE_SSL=true
SMTP_USE_TLS=false
