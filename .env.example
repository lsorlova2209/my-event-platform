# Скопируй в .env на сервере и заполни значения:
#   cp .env.example .env

POSTGRES_DB=sportdok
POSTGRES_USER=sportdok_user
POSTGRES_PASSWORD=смени_на_длинный_пароль

# Случайная длинная строка для JWT (не оставляй пример)
SECRET_KEY=смени_на_случайную_строку_минимум_32_символа

# Публичный адрес сайта (IP или домен)
FRONTEND_URL=http://217.149.19.36
CORS_ORIGINS=http://217.149.19.36

# Пусто = браузер ходит на /api того же хоста через nginx
VITE_API_URL=
